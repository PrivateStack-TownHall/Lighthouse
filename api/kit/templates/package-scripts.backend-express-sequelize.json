{
  "scripts": {
    "dev": "nodemon src/server.js",
    "build": "node scripts/check-source.js",
    "start": "node src/server.js",
    "typecheck": "node scripts/check-source.js",
    "lint": "eslint src tests",
    "test": "node --test \"tests/*.test.js\"",
    "test:watch": "node --test --watch \"tests/*.test.js\"",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:deploy": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "db:setup": "npm run db:create && npm run db:migrate && npm run db:seed",
    "docker:up": "docker compose --env-file .env.docker --profile db --profile api up -d",
    "docker:down": "docker compose --env-file .env.docker down"
  }
}
