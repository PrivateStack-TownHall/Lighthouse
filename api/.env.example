NODE_ENV=development
PORT=3102
# JSON database: a folder of .json files, relative to this api/ folder.
DATABASE_URL=file:../database
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
CORS_ORIGIN=http://localhost:5102

# false (default): local tool, no sign-in. true: generator and projects need a token (ADMIN or STAFF to write).
AUTH_REQUIRED=false

# Seed (npm run db:seed): the first admin account.
ADMIN_EMAIL=admin@lighthouse.local
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Vincent G.
